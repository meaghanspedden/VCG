%% visualise stimuli

% Normalize frequency to a size range you like
minSize = 5;   % minimum bubble size
maxSize = 8;  % maximum bubble size
bubbleSizes = minSize + (T.SignFrequency_M_ - min(T.SignFrequency_M_)) / ...
                       (max(T.SignFrequency_M_) - min(T.SignFrequency_M_)) * (maxSize - minSize);

% Choose a color (RGB) and alpha
bubbleColor = [0, 0.5, 1]; % nice blue
bubbleAlpha = 0.2;         % 0 = transparent, 1 = opaque

figure;
h = bubblechart(T.empirical_aoa, T.SignFrequency_M_, bubbleSizes, bubbleColor);
h.MarkerFaceAlpha = bubbleAlpha;  % set transparency

% Add labels if desired
text(T.empirical_aoa, T.SignFrequency_M_, T.EntryID, ...
     'VerticalAlignment','bottom','HorizontalAlignment','center','FontSize',8)

xlabel('AoA (months)')
ylabel('Frequency (AU)')
title('Selected nouns')
box off

